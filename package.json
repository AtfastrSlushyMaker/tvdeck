{
  "name": "tvdeck",
  "version": "0.2.0",
  "description": "TVDeck: a fast, ad-free home launcher for Samsung Tizen TVs, runs as a TizenBrew app module.",
  "author": "Malek Bsaissa",
  "packageType": "app",
  "appName": "TVDeck",
  "appPath": "app/index.html",
  "serviceFile": "service/service.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/AtfastrSlushyMaker/tvdeck.git"
  },
  "homepage": "https://github.com/AtfastrSlushyMaker/tvdeck#readme",
  "bugs": {
    "url": "https://github.com/AtfastrSlushyMaker/tvdeck/issues"
  },
  "keys": [
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue",
    "ChannelUp",
    "ChannelDown"
  ],
  "files": [
    "app/",
    "service/",
    "assets/brand/tvdeck-wordmark.png",
    "assets/brand/tvdeck-wordmark-dark.png",
    "docs/screenshots/"
  ],
  "keywords": [
    "tizenbrew",
    "tizen",
    "samsung",
    "launcher",
    "smart-tv"
  ],
  "scripts": {
    "dev": "python3 -m http.server 5173 --bind 127.0.0.1 --directory .",
    "service": "TV_HOST=${TV_HOST:-192.168.1.10} node service/service.js"
  },
  "license": "MIT"
}
