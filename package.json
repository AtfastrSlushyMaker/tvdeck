{
  "name": "tvdeck",
  "version": "0.1.0",
  "description": "TVDeck: a fast, ad-free home launcher for Samsung Tizen TVs, runs as a TizenBrew app module.",
  "packageType": "app",
  "appName": "TVDeck",
  "appPath": "app/index.html",
  "serviceFile": "service/service.js",
  "keys": [
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue",
    "ChannelUp",
    "ChannelDown"
  ],
  "files": [
    "app/",
    "service/"
  ],
  "keywords": [
    "tizenbrew",
    "tizen",
    "samsung",
    "launcher",
    "smart-tv"
  ],
  "scripts": {
    "dev": "python3 -m http.server 5173 --bind 127.0.0.1 --directory .",
    "service": "TV_HOST=${TV_HOST:-192.168.1.10} node service/service.js"
  },
  "license": "MIT"
}
